{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "three": ["node_modules/three"],
      "three/addons/*": ["node_modules/@types/three/examples/jsm/*"],
      "three/*": ["node_modules/three/*"],
      "three-mesh-bvh": ["node_modules/three-mesh-bvh"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["../src/ifx/static/viewer.ts", "src/**/*.ts"]
}
